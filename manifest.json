{
  "manifest_version": 3,
  "name": "Polski w kawałkach — Polish practice",
  "short_name": "Polski w kawałkach",
  "version": "1.0.0",
  "description": "Short daily Polish rounds: word tiles, verb forms, listening, dialogues and A2–B1 grammar lessons, with spaced review.",
  "action": {
    "default_title": "Practise Polish",
    "default_popup": "game.html?popup=1",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ]
}